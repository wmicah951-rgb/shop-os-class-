# Required: an API key for an OpenAI-compatible chat endpoint. This deployment uses DeepSeek (https://platform.deepseek.com).
LLM_API_KEY=
# Optional overrides
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# Optional: read live data from shop21-zeta.vercel.app instead of the bundled snapshot (read-only).
DATA_MODE=snapshot
SHOP_OS_URL=https://shop21-zeta.vercel.app
SHOP_OS_EMAIL=
SHOP_OS_PASSWORD=
# Optional: secret used to sign chat state. Defaults to a hash of LLM_API_KEY.
STATE_SECRET=
